# Required. Use a token from a dedicated tournament bot application.
DISCORD_TOKEN=
# PostgreSQL database URL. This bot creates only the vgna_tourney schema.
DATABASE_URL=postgresql://user:password@localhost:5432/vgna
TOURNAMENT_GUILD_ID=

# Optional: Lynx and/or additional organizer IDs, comma-separated.
LYNX_USER_ID=
TOURNAMENT_ORGANIZER_USER_ID=
TOURNAMENT_ORGANIZER_USER_IDS=

# IANA timezone. Defaults to America/Los_Angeles.
TOURNAMENT_TIMEZONE=America/Los_Angeles
# Optional. Existing registrations category/channel are always adopted in place.
# TOURNAMENT_CATEGORY_NAME=Tourney Controls

# Optional ISO local deadlines for tests or a future tournament.
# TEAM_REGISTRATION_DEADLINE=2026-11-30T23:59:59
# SUBSTITUTE_REGISTRATION_DEADLINE=2026-12-11T23:59:59

